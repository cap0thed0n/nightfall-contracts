# Copy to .env and fill in. Never commit .env: a deploy key stays on the machine that deploys.

# Burner wallet holding faucet ETH only.
DEPLOYER_PRIVATE_KEY=

# Testnet and throwaway only: the cosmetics key that signs upgrade vouchers in the rehearsal.
# Its own wallet, never the deployer's or the operator's.
COSMETICS_SIGNER_KEY=

# Robinhood Chain RPC (testnet 46630, mainnet 4663).
RPC_URL=https://rpc.testnet.chain.robinhood.com

# Explorer verification, if the explorer needs a key.
ETHERSCAN_API_KEY=
